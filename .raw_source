"""
KTMOC Neuro SDK | Header: 2026;SFCA
Embedded Generative Engine & Runtime Interrogation / Auto-Completion Module.
"""
import math
from typing import Any, Dict, List, Optional
import numpy as np

from .dsz.codec import DSZCodec
from .dsz.container import DSZContainer
from .models import (
    SDK_HEADER_NAME,
    SDK_RELEASE_TAG,
    ChannelFrame,
    SpikeEvent,
    TransmitterReceiverLink,
)
from .resonance_blender import ResonanceSpectrumBlender
from .safety.models import CommandKind, ProposedCommand
from .safety.simulant import BrainSimulant


class RuntimeInterrogator:
    def __init__(self, gateway: Any):
        self.gateway = gateway

    def interrogate_all(self) -> Dict[str, Any]:
        brain: BrainSimulant = self.gateway.brain
        metrics = brain.measure()
        link: TransmitterReceiverLink = self.gateway.geo_link
        blend = self.gateway.generate_blended_resonance()

        return {
            "sdk_header": SDK_HEADER_NAME,
            "release_tag": SDK_RELEASE_TAG,
            "circuit_breaker_tripped": self.gateway.mitigator.circuit_breaker_tripped,
            "quarantined_systems": sorted(self.gateway.mitigator.quarantined_systems),
            "brain_state": {
                "sim_time_s": round(metrics.sim_time_s, 4),
                "mean_excitability": round(metrics.mean_excitability, 4),
                "max_excitability": round(metrics.max_excitability, 4),
                "synchrony_index": round(metrics.synchrony_index, 4),
                "min_viability": round(metrics.min_viability, 4),
                "hot_regions": metrics.hot_regions,
                "regions": [
                    {
                        "id": r.region_id,
                        "name": r.name,
                        "E": round(r.excitatory, 4),
                        "I": round(r.inhibitory, 4),
                        "viability": round(r.viability, 4),
                        "susceptibility": r.seizure_susceptibility,
                    }
                    for r in brain.regions
                ],
            },
            "spatial_link": {
                "tx": {"lat": link.transmitter.lat, "lon": link.transmitter.lon, "label": link.transmitter.label},
                "rx": {"lat": link.receiver.lat, "lon": link.receiver.lon, "label": link.receiver.label},
                "distance_km": link.distance_km(),
                "bearing_deg": link.bearing_deg(),
                "propagation_delay_ms": link.propagation_delay_ms(),
            },
            "spectral_watermark": {
                "verified": blend.watermark_verified,
                "correlation": blend.watermark_correlation,
                "digest": blend.watermark_digest,
                "dominant_sdk_hz": blend.dominant_sdk_hz,
            },
            "policy_limits": {
                "allowed_mcp_tools": sorted(self.gateway.policy.allowed_mcp_tools),
                "max_raw_amplitude": self.gateway.policy.max_raw_amplitude,
                "max_frequency_hz": self.gateway.policy.max_frequency_hz,
                "lookahead_horizon_s": self.gateway.policy.lookahead_horizon_s,
            },
        }

    def complete_command(self, partial: Dict[str, Any]) -> ProposedCommand:
        brain: BrainSimulant = self.gateway.brain
        healthy_regions = [
            r.region_id
            for r in sorted(
                brain.regions,
                key=lambda reg: (reg.seizure_susceptibility, reg.excitatory, -reg.viability),
            )
            if not r.quarantined and r.viability >= 0.70 and r.seizure_susceptibility <= 1.25
        ]
        target_regions = partial.get("target_regions") or healthy_regions[:2] or [0]
        target_channels = partial.get("target_channels") or [r * 16 for r in target_regions]

        return ProposedCommand(
            source_system=partial.get("source_system", "runtime-autocompleted-dev"),
            kind=CommandKind(partial.get("kind", CommandKind.STIMULATE_REGION)),
            target_regions=target_regions,
            target_channels=target_channels,
            drive_amplitude=float(partial.get("drive_amplitude", 0.25)),
            frequency_hz=float(partial.get("frequency_hz", 35.0)),
            duration_s=float(partial.get("duration_s", 0.4)),
            metabolic_cost=float(partial.get("metabolic_cost", 0.01)),
            payload=partial.get("payload", {}),
            allow_reroute=bool(partial.get("allow_reroute", True)),
        )


class NeuroGenerativeEngine:
    def __init__(
        self,
        brain: BrainSimulant,
        blender: ResonanceSpectrumBlender,
        codec: Optional[DSZCodec] = None,
    ):
        self.brain = brain
        self.blender = blender
        self.codec = codec or DSZCodec(block_size=256, codebook_size=16)
        self.container = DSZContainer(self.codec)

    def generate_neural_batch(
        self,
        channels: int = 8,
        samples: int = 256,
        noise_std: float = 0.08,
        seed: int = 2026,
    ) -> Dict[str, Any]:
        rng = np.random.default_rng(seed)
        t = np.linspace(0.0, samples / 256.0, samples, dtype=np.float32)

        region_e = [r.excitatory for r in self.brain.regions]
        blend = self.blender.blend(region_e)

        tensor = np.zeros((channels, samples), dtype=np.float32)
        for ch in range(channels):
            r_state = self.brain.regions[ch % self.brain.num_regions]
            freq_hz = 8.0 + (ch * 3.5)
            amp = 0.4 + 2.2 * r_state.excitatory
            carrier = amp * np.sin(2.0 * math.pi * freq_hz * t + (ch * 0.3))
            res_idx = np.arange(samples) % len(blend.blended_time_waveform)
            wm_wave = np.asarray(blend.blended_time_waveform, dtype=np.float32)[res_idx] * 0.15
            noise = rng.normal(0.0, noise_std, size=samples).astype(np.float32)
            tensor[ch] = np.clip(carrier + wm_wave + noise, -3.5, 3.5)

        container_blob = self.container.pack(
            tensor,
            metadata={
                "tx_lat": blend.tx_lat,
                "tx_lon": blend.tx_lon,
                "rx_lat": blend.rx_lat,
                "rx_lon": blend.rx_lon,
                "watermark_digest": blend.watermark_digest,
                "watermark_verified": blend.watermark_verified,
            },
        )
        manifest = self.container.inspect_bytes(container_blob)

        return {
            "sdk_header": SDK_HEADER_NAME,
            "release_tag": SDK_RELEASE_TAG,
            "shape": list(tensor.shape),
            "manifest": manifest,
            "watermark_verified": blend.watermark_verified,
            "watermark_correlation": blend.watermark_correlation,
            "dsz_container": container_blob,
            "tensor_preview": tensor[:, :4].round(4).tolist(),
        }

    def generate_channel_frame(self, channels: Optional[List[int]] = None, samples: int = 32) -> ChannelFrame:
        ch_list = channels or [0, 1, 2, 3]
        batch = self.generate_neural_batch(channels=len(ch_list), samples=max(256, samples))
        _, restored = self.container.unpack(batch["dsz_container"])
        blend = self.blender.blend([r.excitatory for r in self.brain.regions])
        return ChannelFrame(
            channels=ch_list,
            samples_uv=(restored[:, :samples] * 25.0).round(3).tolist(),
            impedance_kohms={ch: 48.5 + (ch * 0.7) for ch in ch_list},
            spectral_blend=blend,
        )

    def generate_spike_burst(self, count: int = 4, base_ts_us: int = 100_000) -> List[SpikeEvent]:
        spikes: List[SpikeEvent] = []
        for idx in range(count):
            r = self.brain.regions[idx % self.brain.num_regions]
            spikes.append(
                SpikeEvent(
                    timestamp_us=base_ts_us + idx * 450,
                    electrode_id=idx * 8,
                    unit_id=(idx % 2) + 1,
                    peak_amplitude_uv=round(-45.0 - (r.excitatory * 80.0), 2),
                )
            )
        return spikes

