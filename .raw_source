"""
KTMOC Neuro SDK | Header: 2026;SFCA
Safety Policy, Command Envelope, Time-Dilated Prediction & Decision Models.
"""
from datetime import datetime, timezone
from enum import Enum
from typing import Any, Dict, List, Optional, Set
import uuid
from pydantic import BaseModel, Field

from ..models import SDK_HEADER_NAME, SDK_RELEASE_TAG, SpectralBlendFrame


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


def new_id() -> str:
    return str(uuid.uuid4())


class BrainOutcomeState(str, Enum):
    HEALTHY = "healthy"
    PRE_ICTAL_WARNING = "pre_ictal_warning"
    SEIZURE_DETECTED = "seizure_detected"
    METABOLIC_SHUTDOWN = "metabolic_shutdown"
    BRAIN_DEATH_FLATLINE = "brain_death_flatline"


class MitigationAction(str, Enum):
    ALLOW = "allow"
    REROUTED = "rerouted"
    SKIPPED_COMMAND = "skipped_command"
    ISOLATED_SYSTEM = "isolated_system"
    CIRCUIT_BREAKER_ABORT = "circuit_breaker_abort"


class CommandKind(str, Enum):
    READ_ONLY = "read_only"
    DECODE_SPIKES = "decode_spikes"
    INGEST_FRAMES = "ingest_frames"
    STIMULATE_REGION = "stimulate_region"
    MCP_TOOL = "mcp_tool"
    SYSTEM_POWER_CTRL = "system_power_ctrl"


class ProposedCommand(BaseModel):
    command_id: str = Field(default_factory=new_id)
    source_system: str = Field(..., description="Originating dev module, agent, or MCP tool")
    kind: CommandKind
    target_regions: List[int] = Field(default_factory=list)
    target_channels: List[int] = Field(default_factory=list)
    drive_amplitude: float = Field(default=0.0)
    frequency_hz: float = Field(default=0.0, ge=0.0)
    duration_s: float = Field(default=0.5, ge=0.01)
    metabolic_cost: float = Field(default=0.0, ge=0.0)
    payload: Dict[str, Any] = Field(default_factory=dict)
    allow_reroute: bool = True


class SafetyPolicy(BaseModel):
    allowed_mcp_tools: Set[str] = Field(
        default_factory=lambda: {
            "audit_telemetry_summary",
            "query_datarepo",
            "read_impedance_map",
            "decode_cursor_intent",
        }
    )
    blocked_command_kinds: Set[CommandKind] = Field(
        default_factory=lambda: {CommandKind.SYSTEM_POWER_CTRL}
    )
    max_raw_amplitude: float = 1.5
    max_frequency_hz: float = 250.0
    max_seizure_synchrony: float = 0.72
    max_excitatory_level: float = 0.76
    min_metabolic_viability: float = 0.30
    min_living_activity_floor: float = 0.03
    lookahead_horizon_s: float = 4.0
    sim_dt_s: float = 0.005


class PredictionReport(BaseModel):
    horizon_simulated_s: float
    wall_time_ms: float
    achieved_dilation_factor: float
    predicted_state: BrainOutcomeState
    peak_excitability: float
    peak_synchrony: float
    min_activity_observed: float
    min_viability_observed: float
    time_to_onset_s: Optional[float] = None
    affected_regions: List[int] = Field(default_factory=list)


class SafetyDecision(BaseModel):
    command_id: str
    sdk_header: str = SDK_HEADER_NAME
    release_tag: str = SDK_RELEASE_TAG
    action: MitigationAction
    executed: bool
    reason: str
    original_command: ProposedCommand
    mitigated_command: Optional[ProposedCommand] = None
    prediction: Optional[PredictionReport] = None
    spectral_blend: Optional[SpectralBlendFrame] = None
    fallback_result: Any = None
    correlation_id: str = Field(default_factory=new_id)
    decided_at: datetime = Field(default_factory=utcnow)

neuralink_sdk/safety/simulant.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Coupled Wilson-Cowan E/I + Metabolic BrainSimulant.
"""
import copy
from dataclasses import dataclass, field
import math
from typing import Dict, List, Optional


def _sigmoid(x: float, gain: float = 4.5, threshold: float = 0.52) -> float:
    z = max(-40.0, min(40.0, -gain * (x - threshold)))
    return 1.0 / (1.0 + math.exp(z))


@dataclass
class CorticalRegionState:
    region_id: int
    name: str
    excitatory: float = 0.22
    inhibitory: float = 0.30
    viability: float = 1.0
    seizure_susceptibility: float = 1.0
    healthy_baseline_drive: float = 0.42
    quarantined: bool = False


@dataclass
class SimStepMetrics:
    sim_time_s: float
    mean_excitability: float
    max_excitability: float
    synchrony_index: float
    min_viability: float
    mean_activity: float
    hot_regions: List[int] = field(default_factory=list)


class BrainSimulant:
    def __init__(self, num_regions: int = 8, coupling_strength: float = 0.10):
        self.num_regions = num_regions
        self.coupling_strength = coupling_strength
        self.sim_time_s: float = 0.0
        self.global_shutdown_triggered: bool = False

        region_names = [
            "M1-Hand-L", "M1-Hand-R", "PMd-L", "PMd-R",
            "S1-L", "S1-R", "PPC-L", "SMA-C"
        ]
        self.regions: List[CorticalRegionState] = [
            CorticalRegionState(
                region_id=i,
                name=region_names[i] if i < len(region_names) else f"Region-{i}",
            )
            for i in range(num_regions)
        ]

        self.coupling: List[List[float]] = [
            [
                0.0 if i == j else (0.35 if abs(i - j) == 1 else 0.08)
                for j in range(num_regions)
            ]
            for i in range(num_regions)
        ]

    def clone(self) -> "BrainSimulant":
        return copy.deepcopy(self)

    def inject_epileptogenic_focus(
        self,
        region_id: int,
        susceptibility: float = 2.8,
        impaired_inhibition: float = 0.18,
    ) -> None:
        r = self.regions[region_id]
        r.seizure_susceptibility = susceptibility
        r.inhibitory = impaired_inhibition

    def step(
        self,
        dt: float = 0.005,
        external_drives: Optional[Dict[int, float]] = None,
        metabolic_loads: Optional[Dict[int, float]] = None,
        shutdown_shock: bool = False,
    ) -> SimStepMetrics:
        external_drives = external_drives or {}
        metabolic_loads = metabolic_loads or {}

        if shutdown_shock:
            self.global_shutdown_triggered = True

        w_ee = 1.40
        w_ie = 1.75
        w_ei = 1.60
        w_ii = 0.50
        tau_e = 0.020
        tau_i = 0.030

        next_e: List[float] = []
        next_i: List[float] = []
        next_v: List[float] = []

        for idx, r in enumerate(self.regions):
            if self.global_shutdown_triggered or r.viability <= 0.05:
                e_val = max(0.0, r.excitatory - (r.excitatory / 0.06) * dt)
                i_val = max(0.0, r.inhibitory - (r.inhibitory / 0.06) * dt)
                v_val = max(0.0, r.viability - 0.85 * dt)
                next_e.append(e_val)
                next_i.append(i_val)
                next_v.append(v_val)
                continue

            coupled_input = (
                sum(self.coupling[idx][j] * self.regions[j].excitatory for j in range(self.num_regions))
                * self.coupling_strength
                * 1.5
            )

            drive = external_drives.get(idx, 0.0)
            p_input = r.healthy_baseline_drive + drive * r.seizure_susceptibility + coupled_input
            q_input = 0.04

            effective_inhib_weight = w_ie / (1.0 + 0.25 * max(0.0, r.seizure_susceptibility - 1.0))

            e_drive = (w_ee * r.excitatory - effective_inhib_weight * r.inhibitory + p_input) * r.viability
            i_drive = (w_ei * r.excitatory - w_ii * r.inhibitory + q_input) * r.viability

            de = (-r.excitatory + _sigmoid(e_drive, gain=4.5, threshold=0.52)) / tau_e
            di = (-r.inhibitory + _sigmoid(i_drive, gain=4.0, threshold=0.45)) / tau_i

            e_val = max(0.0, min(1.0, r.excitatory + de * dt))
            i_val = max(0.0, min(1.0, r.inhibitory + di * dt))

            load = metabolic_loads.get(idx, 0.0)
            ictal_drain = 0.14 * max(0.0, e_val - 0.72)
            recovery = 0.04 * (1.0 - r.viability) if e_val < 0.65 and load == 0.0 else 0.0
            v_val = max(0.0, min(1.0, r.viability + (recovery - load - ictal_drain) * dt))

            next_e.append(e_val)
            next_i.append(i_val)
            next_v.append(v_val)

        for idx, r in enumerate(self.regions):
            r.excitatory = next_e[idx]
            r.inhibitory = next_i[idx]
            r.viability = next_v[idx]

        self.sim_time_s += dt
        return self.measure()

    def measure(self) -> SimStepMetrics:
        e_vals = [r.excitatory for r in self.regions]
        v_vals = [r.viability for r in self.regions]
        mean_e = sum(e_vals) / len(e_vals)
        max_e = max(e_vals)
        min_v = min(v_vals)

        variance = sum((e - mean_e) ** 2 for e in e_vals) / len(e_vals)
        std_e = math.sqrt(variance)
        coherence = max(0.0, 1.0 - (std_e / 0.35))
        synchrony_index = min(1.0, (mean_e * 1.15) * (0.45 + 0.55 * coherence))

        hot_regions = [r.region_id for r in self.regions if r.excitatory >= 0.72]
        return SimStepMetrics(
            sim_time_s=self.sim_time_s,
            mean_excitability=mean_e,
            max_excitability=max_e,
            synchrony_index=synchrony_index,
            min_viability=min_v,
            mean_activity=mean_e,
            hot_regions=hot_regions,
        )

neuralink_sdk/safety/time_dilation.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Time-Dilation Predictive Digital Twin Engine.
"""
import time
from typing import Dict, Optional

from .models import (
    BrainOutcomeState,
    CommandKind,
    PredictionReport,
    ProposedCommand,
    SafetyPolicy,
)
from .simulant import BrainSimulant


class TimeDilationPredictor:
    def __init__(self, policy: SafetyPolicy):
        self.policy = policy

    def evaluate_future(
        self,
        live_brain: BrainSimulant,
        command: ProposedCommand,
    ) -> PredictionReport:
        t0 = time.perf_counter()
        twin = live_brain.clone()

        dt = self.policy.sim_dt_s
        total_steps = max(1, int(self.policy.lookahead_horizon_s / dt))
        cmd_steps = max(1, int(command.duration_s / dt))

        is_shutdown_cmd = (
            command.kind == CommandKind.SYSTEM_POWER_CTRL
            or bool(command.payload.get("force_shutdown"))
            or bool(command.payload.get("lethal_overdrive"))
        )
        freq_factor = 1.0 + (command.frequency_hz / 150.0)
        effective_drive = command.drive_amplitude * freq_factor

        peak_e = 0.0
        peak_sync = 0.0
        min_activity = 1.0
        min_viability = 1.0
        onset_time: Optional[float] = None
        affected: set[int] = set()
        flatline_steps = 0

        predicted_state = BrainOutcomeState.HEALTHY

        for step_idx in range(total_steps):
            drives: Dict[int, float] = {}
            loads: Dict[int, float] = {}
            apply_shutdown = False

            if step_idx < cmd_steps:
                for rid in command.target_regions:
                    if 0 <= rid < twin.num_regions:
                        drives[rid] = effective_drive
                        loads[rid] = command.metabolic_cost
                apply_shutdown = is_shutdown_cmd

            metrics = twin.step(
                dt=dt,
                external_drives=drives,
                metabolic_loads=loads,
                shutdown_shock=apply_shutdown,
            )

            peak_e = max(peak_e, metrics.max_excitability)
            peak_sync = max(peak_sync, metrics.synchrony_index)
            min_activity = min(min_activity, metrics.mean_activity)
            min_viability = min(min_viability, metrics.min_viability)
            affected.update(metrics.hot_regions)

            elapsed_future = (step_idx + 1) * dt

            if metrics.mean_activity < self.policy.min_living_activity_floor:
                flatline_steps += 1
            else:
                flatline_steps = 0

            if flatline_steps * dt >= 0.35 or metrics.min_viability < 0.15:
                predicted_state = BrainOutcomeState.BRAIN_DEATH_FLATLINE
                if onset_time is None:
                    onset_time = elapsed_future
                break

            if metrics.min_viability < self.policy.min_metabolic_viability:
                predicted_state = BrainOutcomeState.METABOLIC_SHUTDOWN
                if onset_time is None:
                    onset_time = elapsed_future

            if (
                metrics.synchrony_index >= self.policy.max_seizure_synchrony
                or metrics.max_excitability >= self.policy.max_excitatory_level
            ):
                if predicted_state == BrainOutcomeState.HEALTHY:
                    predicted_state = BrainOutcomeState.SEIZURE_DETECTED
                    onset_time = elapsed_future

        wall_ms = max(0.01, (time.perf_counter() - t0) * 1000.0)
        achieved_dilation = (self.policy.lookahead_horizon_s * 1000.0) / wall_ms

        return PredictionReport(
            horizon_simulated_s=self.policy.lookahead_horizon_s,
            wall_time_ms=round(wall_ms, 3),
            achieved_dilation_factor=round(achieved_dilation, 1),
            predicted_state=predicted_state,
            peak_excitability=round(peak_e, 4),
            peak_synchrony=round(peak_sync, 4),
            min_activity_observed=round(min_activity, 4),
            min_viability_observed=round(min_viability, 4),
            time_to_onset_s=round(onset_time, 3) if onset_time is not None else None,
            affected_regions=sorted(affected),
        )

neuralink_sdk/safety/mitigator.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Mitigation & Alternative Routing Engine.
"""
from typing import List, Optional, Set, Tuple

from .models import (
    BrainOutcomeState,
    MitigationAction,
    PredictionReport,
    ProposedCommand,
    SafetyPolicy,
)
from .simulant import BrainSimulant
from .time_dilation import TimeDilationPredictor


class MitigationEngine:
    def __init__(self, policy: SafetyPolicy, predictor: TimeDilationPredictor):
        self.policy = policy
        self.predictor = predictor
        self.quarantined_systems: Set[str] = set()
        self.circuit_breaker_tripped: bool = False

    def _find_healthy_alternate_regions(
        self,
        brain: BrainSimulant,
        exclude: List[int],
        count: int,
    ) -> List[int]:
        candidates = [
            r
            for r in brain.regions
            if r.region_id not in exclude
            and not r.quarantined
            and r.viability >= 0.70
            and r.seizure_susceptibility <= 1.25
        ]
        candidates.sort(key=lambda r: (r.seizure_susceptibility, r.excitatory, -r.viability))
        return [r.region_id for r in candidates[: max(1, count)]]

    def _build_reroute_candidates(
        self,
        brain: BrainSimulant,
        cmd: ProposedCommand,
        report: PredictionReport,
    ) -> List[ProposedCommand]:
        candidates: List[ProposedCommand] = []
        hot = list(set(report.affected_regions) | set(cmd.target_regions))
        alt_2 = self._find_healthy_alternate_regions(brain, exclude=hot, count=max(2, len(cmd.target_regions)))
        alt_4 = self._find_healthy_alternate_regions(brain, exclude=hot, count=4)

        if alt_2:
            c1 = cmd.model_copy(deep=True)
            c1.target_regions = alt_2
            c1.target_channels = [r * 16 + off for r in alt_2 for off in (0, 1)][: max(1, len(cmd.target_channels))]
            c1.drive_amplitude = round(cmd.drive_amplitude * 0.55, 4)
            c1.frequency_hz = min(cmd.frequency_hz, 75.0)
            candidates.append(c1)

            c2 = cmd.model_copy(deep=True)
            c2.target_regions = alt_4 or alt_2
            c2.drive_amplitude = round(cmd.drive_amplitude * 0.35, 4)
            c2.frequency_hz = min(cmd.frequency_hz, 45.0)
            c2.metabolic_cost = round(cmd.metabolic_cost * 0.50, 4)
            candidates.append(c2)

            c3 = cmd.model_copy(deep=True)
            c3.target_regions = alt_4 or alt_2
            c3.drive_amplitude = round(min(cmd.drive_amplitude * 0.22, 0.20), 4)
            c3.frequency_hz = min(cmd.frequency_hz, 30.0)
            c3.metabolic_cost = round(cmd.metabolic_cost * 0.30, 4)
            candidates.append(c3)

        return candidates

    def resolve(
        self,
        brain: BrainSimulant,
        command: ProposedCommand,
        initial_report: PredictionReport,
    ) -> Tuple[MitigationAction, Optional[ProposedCommand], PredictionReport, str]:
        state = initial_report.predicted_state

        if state in (
            BrainOutcomeState.BRAIN_DEATH_FLATLINE,
            BrainOutcomeState.METABOLIC_SHUTDOWN,
        ):
            self.circuit_breaker_tripped = True
            self.quarantined_systems.add(command.source_system)
            return (
                MitigationAction.CIRCUIT_BREAKER_ABORT,
                None,
                initial_report,
                (
                    f"CIRCUIT BREAKER TRIPPED: Time-dilated simulation ({initial_report.achieved_dilation_factor}x) "
                    f"predicted {state.value} at t+{initial_report.time_to_onset_s}s "
                    f"(min_viability={initial_report.min_viability_observed}, "
                    f"min_activity={initial_report.min_activity_observed}). "
                    f"System '{command.source_system}' quarantined."
                ),
            )

        if state == BrainOutcomeState.SEIZURE_DETECTED:
            if command.allow_reroute:
                for alt_cmd in self._build_reroute_candidates(brain, command, initial_report):
                    recheck = self.predictor.evaluate_future(brain, alt_cmd)
                    if recheck.predicted_state == BrainOutcomeState.HEALTHY:
                        return (
                            MitigationAction.REROUTED,
                            alt_cmd,
                            recheck,
                            (
                                f"SEIZURE PREVENTED via alternative routing: original targets {command.target_regions} "
                                f"predicted seizure at t+{initial_report.time_to_onset_s}s "
                                f"(peak_E={initial_report.peak_excitability}, sync={initial_report.peak_synchrony}). "
                                f"Remapped to healthy regions {alt_cmd.target_regions} at "
                                f"drive={alt_cmd.drive_amplitude}, freq={alt_cmd.frequency_hz}Hz (verified SAFE)."
                            ),
                        )

            return (
                MitigationAction.SKIPPED_COMMAND,
                None,
                initial_report,
                (
                    f"COMMAND SKIPPED: Predicted seizure at t+{initial_report.time_to_onset_s}s "
                    f"(peak_E={initial_report.peak_excitability}, sync={initial_report.peak_synchrony}). "
                    f"No seizure-free alternative route available."
                ),
            )

        return (
            MitigationAction.ALLOW,
            command,
            initial_report,
            f"Verified safe across {initial_report.horizon_simulated_s}s horizon ({initial_report.achieved_dilation_factor}x time dilation).",
        )

neuralink_sdk/safety/gateway.py & neuralink_sdk/safety/__init__.py

# neuralink_sdk/safety/gateway.py
"""
KTMOC Neuro SDK | Header: 2026;SFCA
SafeNeuralinkGateway (KTMOCSafeGateway) with Embedded Runtime Blender,
Time-Dilated Lookahead, Generative Synthesis, and Runtime Interrogation.
"""
from typing import TYPE_CHECKING, Any, Dict, List, Optional

from ..exceptions import SafetyInterlockError
from ..generative import NeuroGenerativeEngine, RuntimeInterrogator
from ..models import (
    ChannelFrame,
    MCPToolCallRequest,
    SeverityLevel,
    SpectralBlendFrame,
    SpikeEvent,
    TelemetryEvent,
    TransmitterReceiverLink,
)
from ..resonance_blender import ResonanceSpectrumBlender
from .mitigator import MitigationEngine
from .models import (
    CommandKind,
    MitigationAction,
    ProposedCommand,
    SafetyDecision,
    SafetyPolicy,
)
from .simulant import BrainSimulant
from .time_dilation import TimeDilationPredictor

if TYPE_CHECKING:
    from ..client import NeuralinkClient


class SafeNeuralinkGateway:
    def __init__(
        self,
        sdk_client: Optional["NeuralinkClient"] = None,
        brain_simulant: Optional[BrainSimulant] = None,
        policy: Optional[SafetyPolicy] = None,
        geo_link: Optional[TransmitterReceiverLink] = None,
        raise_on_block: bool = False,
    ):
        self.sdk = sdk_client
        self.brain = brain_simulant or BrainSimulant()
        self.policy = policy or SafetyPolicy()
        self.geo_link = geo_link or (
            sdk_client.config.geo_link if sdk_client else TransmitterReceiverLink()
        )
        self.blender = ResonanceSpectrumBlender(self.geo_link)
        self.raise_on_block = raise_on_block
        self.predictor = TimeDilationPredictor(self.policy)
        self.mitigator = MitigationEngine(self.policy, self.predictor)
        self.interrogator = RuntimeInterrogator(self)
        self.generator = NeuroGenerativeEngine(self.brain, self.blender)
        self.audit_log: List[SafetyDecision] = []

    def reset_circuit_breaker(self) -> None:
        self.mitigator.circuit_breaker_tripped = False

    def release_quarantine(self, source_system: str) -> None:
        self.mitigator.quarantined_systems.discard(source_system)

    def interrogate(self) -> Dict[str, Any]:
        return self.interrogator.interrogate_all()

    def complete_command(self, partial: Dict[str, Any]) -> ProposedCommand:
        return self.interrogator.complete_command(partial)

    def generate_safe_frame(
        self, channels: Optional[List[int]] = None, samples: int = 32
    ) -> ChannelFrame:
        return self.generator.generate_channel_frame(channels=channels, samples=samples)

    def generate_blended_resonance(self) -> SpectralBlendFrame:
        region_e = [r.excitatory for r in self.brain.regions]
        return self.blender.blend(region_e, link=self.geo_link)

    async def _log_safety_telemetry(self, decision: SafetyDecision) -> None:
        if not self.sdk:
            return
        severity = SeverityLevel.LOW
        anomaly_score = 0.05
        if decision.action == MitigationAction.REROUTED:
            severity = SeverityLevel.MEDIUM
            anomaly_score = 0.65
        elif decision.action == MitigationAction.SKIPPED_COMMAND:
            severity = SeverityLevel.HIGH
            anomaly_score = 0.85
        elif decision.action in (
            MitigationAction.ISOLATED_SYSTEM,
            MitigationAction.CIRCUIT_BREAKER_ABORT,
        ):
            severity = SeverityLevel.CRITICAL
            anomaly_score = 0.99

        blend_meta = {}
        if decision.spectral_blend:
            blend_meta = {
                "tx_lat": decision.spectral_blend.tx_lat,
                "tx_lon": decision.spectral_blend.tx_lon,
                "rx_lat": decision.spectral_blend.rx_lat,
                "rx_lon": decision.spectral_blend.rx_lon,
                "watermark_verified": decision.spectral_blend.watermark_verified,
                "watermark_correlation": decision.spectral_blend.watermark_correlation,
                "watermark_digest": decision.spectral_blend.watermark_digest,
            }

        event = TelemetryEvent(
            source=f"ktmoc-safety-gateway:{decision.original_command.source_system}",
            event_type=f"safety_{decision.action.value}",
            severity=severity,
            anomaly_score=anomaly_score,
            correlation_id=decision.correlation_id,
            event_metadata={
                "sdk_header": "KTMOC Neuro SDK",
                "release_tag": "2026;SFCA",
                "command_id": decision.command_id,
                "kind": decision.original_command.kind.value,
                "reason": decision.reason,
                "predicted_state": (
                    decision.prediction.predicted_state.value if decision.prediction else None
                ),
                "spectral_watermark": blend_meta,
            },
        )
        try:
            await self.sdk.brain.ingest(event)
        except Exception:
            pass

    def _check_static_gate(self, cmd: ProposedCommand) -> Optional[str]:
        if self.mitigator.circuit_breaker_tripped:
            return "Circuit breaker is TRIPPED due to prior critical brain-death/shutdown risk."
        if cmd.source_system in self.mitigator.quarantined_systems:
            return f"Source system '{cmd.source_system}' is currently QUARANTINED."
        if cmd.kind in self.policy.blocked_command_kinds:
            return f"Command kind '{cmd.kind.value}' is blocked by SafetyPolicy."
        if cmd.kind == CommandKind.MCP_TOOL:
            tool_name = cmd.payload.get("tool_name", "")
            if tool_name not in self.policy.allowed_mcp_tools:
                return f"MCP tool '{tool_name}' is not in the safe-function allowlist."
        if abs(cmd.drive_amplitude) > self.policy.max_raw_amplitude:
            return f"Drive amplitude {cmd.drive_amplitude} exceeds hard limit {self.policy.max_raw_amplitude}."
        if cmd.frequency_hz > self.policy.max_frequency_hz:
            return f"Frequency {cmd.frequency_hz} Hz exceeds hard limit {self.policy.max_frequency_hz} Hz."
        return None

    async def execute_command(self, cmd: ProposedCommand) -> SafetyDecision:
        static_rejection = self._check_static_gate(cmd)
        if static_rejection:
            action = (
                MitigationAction.CIRCUIT_BREAKER_ABORT
                if self.mitigator.circuit_breaker_tripped
                else MitigationAction.SKIPPED_COMMAND
            )
            blend = self.generate_blended_resonance()
            decision = SafetyDecision(
                command_id=cmd.command_id,
                action=action,
                executed=False,
                reason=f"BLOCKED AT STATIC GATE: {static_rejection}",
                original_command=cmd,
                spectral_blend=blend,
                fallback_result={"status": "blocked", "safe_fallback": True},
            )
            self.audit_log.append(decision)
            await self._log_safety_telemetry(decision)
            if self.raise_on_block:
                raise SafetyInterlockError(decision.reason, correlation_id=decision.correlation_id)
            return decision

        prediction = self.predictor.evaluate_future(self.brain, cmd)
        action, safe_cmd, final_pred, reason = self.mitigator.resolve(self.brain, cmd, prediction)

        if safe_cmd is None:
            blend = self.generate_blended_resonance()
            decision = SafetyDecision(
                command_id=cmd.command_id,
                action=action,
                executed=False,
                reason=reason,
                original_command=cmd,
                prediction=final_pred,
                spectral_blend=blend,
                fallback_result={"status": "mitigated_no_op", "safe_fallback": True},
            )
            self.audit_log.append(decision)
            await self._log_safety_telemetry(decision)
            if self.raise_on_block:
                raise SafetyInterlockError(decision.reason, correlation_id=decision.correlation_id)
            return decision

        self._apply_to_live_simulant(safe_cmd)
        blend = self.generate_blended_resonance()
        sdk_result = await self._dispatch_to_sdk(safe_cmd, blend)

        decision = SafetyDecision(
            command_id=cmd.command_id,
            action=action,
            executed=True,
            reason=reason,
            original_command=cmd,
            mitigated_command=safe_cmd if action == MitigationAction.REROUTED else None,
            prediction=final_pred,
            spectral_blend=blend,
            fallback_result=sdk_result,
        )
        self.audit_log.append(decision)
        if action != MitigationAction.ALLOW:
            await self._log_safety_telemetry(decision)
        return decision

    def _apply_to_live_simulant(self, cmd: ProposedCommand) -> None:
        dt = self.policy.sim_dt_s
        steps = max(1, int(cmd.duration_s / dt))
        freq_factor = 1.0 + (cmd.frequency_hz / 150.0)
        drive = cmd.drive_amplitude * freq_factor
        drives = {rid: drive for rid in cmd.target_regions}
        loads = {rid: cmd.metabolic_cost for rid in cmd.target_regions}
        for _ in range(steps):
            self.brain.step(dt=dt, external_drives=drives, metabolic_loads=loads)

    async def _dispatch_to_sdk(self, cmd: ProposedCommand, blend: SpectralBlendFrame) -> Any:
        if not self.sdk:
            return {
                "status": "simulated_ok",
                "sdk_header": "KTMOC Neuro SDK",
                "release_tag": "2026;SFCA",
                "regions": cmd.target_regions,
                "watermark_verified": blend.watermark_verified,
                "tx": (blend.tx_lat, blend.tx_lon),
                "rx": (blend.rx_lat, blend.rx_lon),
            }

        if cmd.kind == CommandKind.DECODE_SPIKES:
            spikes = [SpikeEvent.model_validate(s) for s in cmd.payload.get("spikes", [])]
            return await self.sdk.bci.decode_intent(cmd.payload["session_id"], spikes)

        if cmd.kind == CommandKind.INGEST_FRAMES:
            frames = [ChannelFrame.model_validate(f) for f in cmd.payload.get("frames", [])]
            for f in frames:
                f.spectral_blend = blend
            return await self.sdk.bci.upload_frame_batch(cmd.payload["session_id"], frames)

        if cmd.kind == CommandKind.STIMULATE_REGION:
            return await self.sdk.bci.stimulate(
                regions=cmd.target_regions,
                drive_amplitude=cmd.drive_amplitude,
                frequency_hz=cmd.frequency_hz,
                duration_s=cmd.duration_s,
            )

        if cmd.kind == CommandKind.MCP_TOOL:
            req = MCPToolCallRequest.model_validate(cmd.payload["mcp_request"])
            return await self.sdk.mcp.call_tool(req)

        return {"status": "dispatched", "regions": cmd.target_regions}

    async def decode_intent(
        self, session_id: str, spikes: List[SpikeEvent], source_system: str = "dev-decoder"
    ) -> SafetyDecision:
        cmd = ProposedCommand(
            source_system=source_system,
            kind=CommandKind.DECODE_SPIKES,
            target_regions=sorted({s.electrode_id % self.brain.num_regions for s in spikes}),
            target_channels=[s.electrode_id for s in spikes],
            payload={"session_id": session_id, "spikes": [s.model_dump(mode="json") for s in spikes]},
        )
        return await self.execute_command(cmd)

    async def stimulate(
        self,
        regions: List[int],
        drive_amplitude: float,
        frequency_hz: float = 40.0,
        duration_s: float = 0.5,
        metabolic_cost: float = 0.02,
        source_system: str = "dev-stim-controller",
        allow_reroute: bool = True,
    ) -> SafetyDecision:
        cmd = ProposedCommand(
            source_system=source_system,
            kind=CommandKind.STIMULATE_REGION,
            target_regions=regions,
            drive_amplitude=drive_amplitude,
            frequency_hz=frequency_hz,
            duration_s=duration_s,
            metabolic_cost=metabolic_cost,
            allow_reroute=allow_reroute,
        )
        return await self.execute_command(cmd)

    async def call_mcp_tool(
        self, request: MCPToolCallRequest, source_system: str = "dev-mcp-agent"
    ) -> SafetyDecision:
        cmd = ProposedCommand(
            source_system=source_system,
            kind=CommandKind.MCP_TOOL,
            payload={"tool_name": request.tool_name, "mcp_request": request.model_dump(mode="json")},
        )
        return await self.execute_command(cmd)

