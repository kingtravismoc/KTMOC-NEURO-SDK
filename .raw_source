11. mock_server.py (Complete Reference Server)

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Unified Reference FastAPI Server.
Run: uvicorn mock_server:app --port 8000
"""
import asyncio
from datetime import datetime, timezone
import math
import time
import uuid
from typing import Dict, List, Optional
from fastapi import Body, FastAPI, Header, HTTPException, WebSocket, WebSocketDisconnect

from neuralink_sdk import (
    GeoCoordinates,
    ResonanceSpectrumBlender,
    SDK_HEADER_NAME,
    SDK_RELEASE_TAG,
    TransmitterReceiverLink,
)

app = FastAPI(title=f"{SDK_HEADER_NAME} ({SDK_RELEASE_TAG})", version="2026.1.0")

TELEMETRY_DB: List[dict] = []
DATASETS_DB: Dict[str, dict] = {}
STIM_LOG: List[dict] = []


def verify_key(x_api_key: Optional[str]):
    if not x_api_key:
        raise HTTPException(status_code=401, detail="Missing X-API-Key header")


def parse_geo_link(tx_hdr: Optional[str], rx_hdr: Optional[str]) -> TransmitterReceiverLink:
    tx = GeoCoordinates(lat=37.7749, lon=-122.4194, label="SFCA-TX")
    rx = GeoCoordinates(lat=30.2672, lon=-97.7431, label="AUS-RX")
    if tx_hdr and "," in tx_hdr:
        lat, lon = tx_hdr.split(",", 1)
        tx = GeoCoordinates(lat=float(lat), lon=float(lon), label="TX")
    if rx_hdr and "," in rx_hdr:
        lat, lon = rx_hdr.split(",", 1)
        rx = GeoCoordinates(lat=float(lat), lon=float(lon), label="RX")
    return TransmitterReceiverLink(transmitter=tx, receiver=rx)


@app.get("/health")
async def health():
    return {
        "status": "ok",
        "sdk_header": SDK_HEADER_NAME,
        "release_tag": SDK_RELEASE_TAG,
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


@app.post("/api/v1/resonance/blend")
async def blend_resonance(
    payload: dict = Body(...),
    x_api_key: Optional[str] = Header(default=None),
    x_ktmoc_tx_geo: Optional[str] = Header(default=None),
    x_ktmoc_rx_geo: Optional[str] = Header(default=None),
):
    verify_key(x_api_key)
    link = parse_geo_link(x_ktmoc_tx_geo, x_ktmoc_rx_geo)
    blender = ResonanceSpectrumBlender(link)
    frame = blender.blend(payload.get("region_excitabilities", [0.22] * 8))
    return frame.model_dump(mode="json")


@app.post("/api/v1/brain/telemetry")
async def ingest_telemetry(
    payload: dict = Body(...),
    x_api_key: Optional[str] = Header(default=None),
    x_tenant_id: Optional[str] = Header(default=None),
    x_ktmoc_tx_geo: Optional[str] = Header(default=None),
    x_ktmoc_rx_geo: Optional[str] = Header(default=None),
):
    verify_key(x_api_key)
    payload.setdefault("id", str(uuid.uuid4()))
    payload["tenant_id"] = payload.get("tenant_id") or x_tenant_id
    payload["sdk_header"] = SDK_HEADER_NAME
    payload["release_tag"] = SDK_RELEASE_TAG
    payload["tx_geo"] = x_ktmoc_tx_geo
    payload["rx_geo"] = x_ktmoc_rx_geo
    payload.setdefault("created_at", datetime.now(timezone.utc).isoformat())
    TELEMETRY_DB.append(payload)
    return payload


@app.get("/api/v1/brain/flows/{correlation_id}")
async def trace_flow(correlation_id: str, x_api_key: Optional[str] = Header(default=None)):
    verify_key(x_api_key)
    return {"correlation_id": correlation_id, "events": [e for e in TELEMETRY_DB if e.get("correlation_id") == correlation_id]}


@app.get("/api/v1/brain/anomalies")
async def get_anomalies(threshold: float = 0.75, limit: int = 50, x_api_key: Optional[str] = Header(default=None)):
    verify_key(x_api_key)
    return {"anomalies": [e for e in TELEMETRY_DB if e.get("anomaly_score", 0.0) >= threshold][:limit]}


@app.post("/api/v1/datarepo/datasets")
async def register_dataset(payload: dict = Body(...), x_api_key: Optional[str] = Header(default=None)):
    verify_key(x_api_key)
    DATASETS_DB[payload["dataset_id"]] = payload
    return payload


@app.get("/api/v1/datarepo/datasets")
async def list_datasets(
    modality: Optional[str] = None,
    subject_code: Optional[str] = None,
    limit: int = 25,
    x_api_key: Optional[str] = Header(default=None),
):
    verify_key(x_api_key)
    results = list(DATASETS_DB.values())
    if modality:
        results = [d for d in results if d.get("modality") == modality]
    if subject_code:
        results = [d for d in results if d.get("subject_code") == subject_code]
    return {"datasets": results[:limit]}


@app.post("/api/v1/bci/frames/batch")
async def upload_frames(payload: dict = Body(...), x_api_key: Optional[str] = Header(default=None)):
    verify_key(x_api_key)
    return {"accepted": len(payload.get("frames", [])), "session_id": payload.get("session_id")}


@app.post("/api/v1/bci/decode")
async def decode_intent(payload: dict = Body(...), x_api_key: Optional[str] = Header(default=None)):
    verify_key(x_api_key)
    spikes = payload.get("spikes", [])
    n = max(len(spikes), 1)
    vx = sum(s.get("peak_amplitude_uv", 0.0) for s in spikes) / (n * 100.0)
    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "session_id": payload["session_id"],
        "velocity_x": round(vx, 4),
        "velocity_y": round(-vx * 0.5, 4),
        "velocity_z": 0.0,
        "click_probability": min(1.0, round(len(spikes) / 20.0, 3)),
        "confidence": 0.94,
        "latency_ms": 4.2,
    }


@app.post("/api/v1/bci/stimulate")
async def execute_stimulation(payload: dict = Body(...), x_api_key: Optional[str] = Header(default=None)):
    verify_key(x_api_key)
    record = {"id": str(uuid.uuid4()), "executed_at": datetime.now(timezone.utc).isoformat(), **payload}
    STIM_LOG.append(record)
    return {"status": "stimulation_delivered", **record}


@app.post("/api/v1/mcp/tools/call")
async def mcp_call(payload: dict = Body(...), x_api_key: Optional[str] = Header(default=None)):
    verify_key(x_api_key)
    t0 = time.perf_counter()
    return {
        "tool_name": payload["tool_name"],
        "status": "success",
        "output": {"executed_args": payload.get("arguments", {}), "total_events": len(TELEMETRY_DB)},
        "execution_ms": round((time.perf_counter() - t0) * 1000, 3),
        "correlation_id": payload.get("correlation_id", str(uuid.uuid4())),
    }


@app.websocket("/ws/v1/bci/sessions/{session_id}")
async def bci_ws_stream(websocket: WebSocket, session_id: str):
    await websocket.accept()
    channels = [0, 1, 2, 3]
    blender = ResonanceSpectrumBlender(TransmitterReceiverLink())
    try:
        tick = 0
        while True:
            region_e = [0.22 + 0.04 * math.sin((tick + i) * 0.25) for i in range(8)]
            blend = blender.blend(region_e)
            frame = {
                "frame_id": str(uuid.uuid4()),
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "sample_rate_hz": 20000,
                "channels": channels,
                "samples_uv": [[round(math.sin((tick + ch) * 0.2) * 45.0, 2) for _ in range(10)] for ch in channels],
                "impedance_kohms": {str(ch): 52.4 for ch in channels},
                "spectral_blend": blend.model_dump(mode="json"),
            }
            await websocket.send_json(frame)
            tick += 1
            await asyncio.sleep(0.05)
    except WebSocketDisconnect:
        pass

12. test_full_platform.py (End-to-End Automated Verification Suite)

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Full Platform Verification Suite.
"""
import asyncio
import os
import tempfile
import numpy as np

from neuralink_sdk import (
    BrainOutcomeState,
    BrainSimulant,
    CommandKind,
    DSZCodec,
    DSZContainer,
    GeoCoordinates,
    KTMOCSafeGateway,
    MCPToolCallRequest,
    MitigationAction,
    ProposedCommand,
    SDK_HEADER_NAME,
    SDK_RELEASE_TAG,
    TransmitterReceiverLink,
    decompress_payload_parallel,
)


async def run_full_platform_tests():
    sim = BrainSimulant(num_regions=8)
    sim.inject_epileptogenic_focus(region_id=2, susceptibility=2.8, impaired_inhibition=0.18)

    geo_link = TransmitterReceiverLink(
        transmitter=GeoCoordinates(lat=37.7749, lon=-122.4194, label="SFCA-TX"),
        receiver=GeoCoordinates(lat=30.2672, lon=-97.7431, label="AUS-RX"),
    )
    gateway = KTMOCSafeGateway(sdk_client=None, brain_simulant=sim, geo_link=geo_link)

    print(f"\n=== 1. {SDK_HEADER_NAME} ({SDK_RELEASE_TAG}) Runtime Interrogation ===")
    intro = gateway.interrogate()
    assert intro["sdk_header"] == "KTMOC Neuro SDK"
    assert intro["release_tag"] == "2026;SFCA"
    assert intro["spectral_watermark"]["verified"] is True
    print(f"Link: {intro['spatial_link']['distance_km']} km | Watermark corr={intro['spectral_watermark']['correlation']}")

    print("\n=== 2. Embedded Generative Engine + DSZ1 Container + Parallel Decompress ===")
    gen_out = gateway.generator.generate_neural_batch(channels=8, samples=256)
    dsz_blob = gen_out["dsz_container"]
    container = DSZContainer()
    manifest, restored_tensor = container.unpack(dsz_blob)
    assert manifest["sdk_header"] == "KTMOC Neuro SDK"
    assert manifest["release_tag"] == "2026;SFCA"
    assert manifest["metadata"]["watermark_verified"] is True
    assert restored_tensor.shape == (8, 256)

    codec = DSZCodec(block_size=256, codebook_size=16)
    raw_payload, stats = codec.encode(restored_tensor)
    with tempfile.NamedTemporaryFile(delete=False, suffix=".dszraw") as tmp:
        tmp.write(raw_payload)
        tmp_path = tmp.name
    try:
        parallel_out = decompress_payload_parallel(tmp_path, output_shape=(8, 256))
        assert parallel_out.shape == (8, 256)
        mse = float(np.mean((restored_tensor - parallel_out) ** 2))
        print(f"DSZ Roundtrip Ratio={stats['compression_ratio']}x | Parallel Decompress MSE={mse:.6f}")
        assert mse < 0.05
    finally:
        os.unlink(tmp_path)

    print("\n=== 3. Runtime Command Auto-Completion + Safe Execution ===")
    auto_cmd = gateway.complete_command({"drive_amplitude": 0.25, "frequency_hz": 30.0})
    assert 2 not in auto_cmd.target_regions
    res_auto = await gateway.execute_command(auto_cmd)
    assert res_auto.action == MitigationAction.ALLOW
    assert res_auto.executed is True
    print(f"Auto-completed regions={auto_cmd.target_regions} -> Action={res_auto.action.value}")

    print("\n=== 4. Generative Spike Burst -> Decode + Watermark Check ===")
    spikes = gateway.generator.generate_spike_burst(count=4)
    res_dec = await gateway.decode_intent("sess_gen_01", spikes)
    assert res_dec.action == MitigationAction.ALLOW
    assert res_dec.spectral_blend is not None and res_dec.spectral_blend.watermark_verified is True

    print("\n=== 5. Time-Dilated Seizure Detection -> Alternative Routing ===")
    res_seiz = await gateway.stimulate(
        regions=[2], drive_amplitude=0.75, frequency_hz=120.0, duration_s=0.8, allow_reroute=True
    )
    assert res_seiz.action == MitigationAction.REROUTED
    assert res_seiz.executed is True
    assert res_seiz.mitigated_command is not None and 2 not in res_seiz.mitigated_command.target_regions
    print(f"Seizure Prevented -> Rerouted to {res_seiz.mitigated_command.target_regions}")

    print("\n=== 6. Unmitigable Command & Disallowed MCP Tool -> Skip ===")
    res_skip = await gateway.stimulate(
        regions=[2], drive_amplitude=0.95, frequency_hz=140.0, duration_s=1.0, allow_reroute=False
    )
    assert res_skip.action == MitigationAction.SKIPPED_COMMAND
    res_mcp = await gateway.call_mcp_tool(MCPToolCallRequest(tool_name="override_voltage_regulator"))
    assert res_mcp.action == MitigationAction.SKIPPED_COMMAND

    print("\n=== 7. Shutdown / Brain-Death Flatline -> Circuit Breaker ===")
    lethal = ProposedCommand(
        source_system="faulty-power-daemon",
        kind=CommandKind.STIMULATE_REGION,
        target_regions=[0, 1, 3, 4],
        drive_amplitude=0.5,
        frequency_hz=60.0,
        duration_s=1.5,
        metabolic_cost=0.95,
        payload={"force_shutdown": True},
    )
    res_abort = await gateway.execute_command(lethal)
    assert res_abort.action == MitigationAction.CIRCUIT_BREAKER_ABORT
    assert res_abort.prediction is not None
    assert res_abort.prediction.predicted_state == BrainOutcomeState.BRAIN_DEATH_FLATLINE
    assert gateway.brain.global_shutdown_triggered is False
    print("ALL 7 PLATFORM VERIFICATION STAGES PASSED.")


if __name__ == "__main__":
    asyncio.run(run_full_platform_tests())

