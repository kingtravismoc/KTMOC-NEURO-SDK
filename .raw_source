# neuralink_sdk/client.py
"""
KTMOC Neuro SDK | Header: 2026;SFCA
Primary SDK Client with Integrated Safety Gateway, Blender, DSZ & Generative Engine.
"""
from typing import List, Optional
from .models import SDKConfig, SpectralBlendFrame, TransmitterReceiverLink
from .resonance_blender import ResonanceSpectrumBlender
from .resources import BCIStreamResource, BrainTelemetryResource, DataRepoResource, MCPResource
from .safety import BrainSimulant, SafeNeuralinkGateway, SafetyPolicy
from .transport import AsyncHTTPTransport


class NeuralinkClient:
    def __init__(
        self,
        api_key: str,
        base_url: str = "http://localhost:8000",
        ws_url: str = "ws://localhost:8000",
        tenant_id: Optional[str] = None,
        geo_link: Optional[TransmitterReceiverLink] = None,
        timeout: float = 30.0,
        max_retries: int = 3,
    ):
        self.config = SDKConfig(
            api_key=api_key,
            base_url=base_url,
            ws_url=ws_url,
            tenant_id=tenant_id,
            geo_link=geo_link or TransmitterReceiverLink(),
            timeout=timeout,
            max_retries=max_retries,
        )
        self._transport = AsyncHTTPTransport(self.config)
        self.blender = ResonanceSpectrumBlender(self.config.geo_link)
        self.brain = BrainTelemetryResource(self._transport)
        self.datarepo = DataRepoResource(self._transport)
        self.bci = BCIStreamResource(self.config, self._transport)
        self.mcp = MCPResource(self._transport)

    def blend_resonance(self, region_excitabilities: Optional[List[float]] = None) -> SpectralBlendFrame:
        return self.blender.blend(region_excitabilities or [0.22] * 8, link=self.config.geo_link)

    def with_safety(
        self,
        brain_simulant: Optional[BrainSimulant] = None,
        policy: Optional[SafetyPolicy] = None,
        raise_on_block: bool = False,
    ) -> SafeNeuralinkGateway:
        return SafeNeuralinkGateway(
            sdk_client=self,
            brain_simulant=brain_simulant,
            policy=policy,
            geo_link=self.config.geo_link,
            raise_on_block=raise_on_block,
        )

    async def health(self) -> dict:
        return await self._transport.request("GET", "/health")

    async def close(self) -> None:
        await self._transport.close()

    async def __aenter__(self) -> "NeuralinkClient":
        return self

    async def __aexit__(self, exc_type, exc_val, exc_tb) -> None:
        await self.close()


KTMOCNeuroClient = NeuralinkClient

