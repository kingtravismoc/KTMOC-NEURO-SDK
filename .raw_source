2. neuralink_sdk/exceptions.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Unified Exception Hierarchy.
"""
from typing import Any, Dict, Optional


class NeuralinkSDKError(Exception):
    """Base exception for all KTMOC Neuro SDK errors."""

    def __init__(
        self,
        message: str,
        status_code: Optional[int] = None,
        correlation_id: Optional[str] = None,
        details: Optional[Dict[str, Any]] = None,
    ):
        super().__init__(message)
        self.message = message
        self.status_code = status_code
        self.correlation_id = correlation_id
        self.details = details or {}

    def __str__(self) -> str:
        parts = [f"[KTMOC Neuro SDK | 2026;SFCA] {self.message}"]
        if self.status_code:
            parts.append(f"(HTTP {self.status_code})")
        if self.correlation_id:
            parts.append(f"[Correlation-ID: {self.correlation_id}]")
        return " ".join(parts)


class AuthenticationError(NeuralinkSDKError):
    """Raised when X-API-Key authentication fails (401/403)."""


class NotFoundError(NeuralinkSDKError):
    """Raised when a requested resource is not found (404)."""


class RateLimitError(NeuralinkSDKError):
    """Raised when rate limits are exceeded (429)."""


class ValidationError(NeuralinkSDKError):
    """Raised when schema or parameter validation fails (400/422)."""


class StreamConnectionError(NeuralinkSDKError):
    """Raised when a live WebSocket stream drops unexpectedly."""


class SafetyInterlockError(NeuralinkSDKError):
    """Raised when strict safety mode blocks an unsafe or seizure/shutdown-inducing command."""

3. neuralink_sdk/models.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Core Data Models, Geospatial Calibration Link & Spectral Resonance Structures.
"""
from datetime import datetime, timezone
from enum import Enum
import math
from typing import Any, Dict, List, Literal, Optional
import uuid
from pydantic import BaseModel, ConfigDict, Field

SDK_HEADER_NAME = "KTMOC Neuro SDK"
SDK_RELEASE_TAG = "2026;SFCA"


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


def new_id() -> str:
    return str(uuid.uuid4())


class GeoCoordinates(BaseModel):
    """Standard WGS-84 spatial reference coordinates for station calibration."""
    lat: float = Field(..., ge=-90.0, le=90.0, description="Latitude in decimal degrees")
    lon: float = Field(..., ge=-180.0, le=180.0, description="Longitude in decimal degrees")
    altitude_m: float = Field(default=0.0, description="Elevation in meters")
    label: str = Field(default="node")


class TransmitterReceiverLink(BaseModel):
    """Geospatial calibration link between Transmitter (TX) and Receiver (RX)."""
    transmitter: GeoCoordinates = Field(
        default_factory=lambda: GeoCoordinates(lat=37.7749, lon=-122.4194, label="SFCA-TX")
    )
    receiver: GeoCoordinates = Field(
        default_factory=lambda: GeoCoordinates(lat=30.2672, lon=-97.7431, label="AUS-RX")
    )

    def distance_km(self) -> float:
        r_earth_km = 6371.0
        lat1, lon1 = math.radians(self.transmitter.lat), math.radians(self.transmitter.lon)
        lat2, lon2 = math.radians(self.receiver.lat), math.radians(self.receiver.lon)
        dlat = lat2 - lat1
        dlon = lon2 - lon1
        a = math.sin(dlat / 2) ** 2 + math.cos(lat1) * math.cos(lat2) * math.sin(dlon / 2) ** 2
        return round(2.0 * r_earth_km * math.asin(math.sqrt(min(1.0, a))), 4)

    def bearing_deg(self) -> float:
        lat1, lon1 = math.radians(self.transmitter.lat), math.radians(self.transmitter.lon)
        lat2, lon2 = math.radians(self.receiver.lat), math.radians(self.receiver.lon)
        dlon = lon2 - lon1
        y = math.sin(dlon) * math.cos(lat2)
        x = math.cos(lat1) * math.sin(lat2) - math.sin(lat1) * math.cos(lat2) * math.cos(dlon)
        return round((math.degrees(math.atan2(y, x)) + 360.0) % 360.0, 2)

    def propagation_delay_ms(self) -> float:
        return round((self.distance_km() / 200_000.0) * 1000.0, 4)


class SpectralBlendFrame(BaseModel):
    """Frequency-spectrum blended frame containing SDK resonance, ground resonance & 2026;SFCA watermark."""
    sdk_header: str = SDK_HEADER_NAME
    release_tag: str = SDK_RELEASE_TAG
    timestamp: datetime = Field(default_factory=utcnow)
    sample_rate_hz: float = 128.0
    fft_size: int = 128
    tx_lat: float
    tx_lon: float
    rx_lat: float
    rx_lon: float
    link_distance_km: float
    link_bearing_deg: float
    watermark_digest: str
    watermark_verified: bool
    watermark_correlation: float
    ground_resonance_hz: List[float]
    dominant_sdk_hz: float
    blended_spectrum_magnitudes: List[float]
    blended_time_waveform: List[float]


class ModalityType(str, Enum):
    ELECTROPHYSIOLOGY = "electrophysiology"
    SPIKE_TRAINS = "spike_trains"
    LFP = "local_field_potential"
    KINEMATICS = "kinematics"
    IMPEDANCE = "impedance"
    SYSTEM_TELEMETRY = "system_telemetry"
    RESONANCE_SPECTRUM = "resonance_spectrum"


class SeverityLevel(str, Enum):
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    CRITICAL = "critical"


class SDKConfig(BaseModel):
    model_config = ConfigDict(arbitrary_types_allowed=True)

    sdk_header: str = SDK_HEADER_NAME
    release_tag: str = SDK_RELEASE_TAG
    base_url: str = "http://localhost:8000"
    ws_url: str = "ws://localhost:8000"
    api_key: str = Field(..., description="X-API-Key for authentication")
    tenant_id: Optional[str] = None
    geo_link: TransmitterReceiverLink = Field(default_factory=TransmitterReceiverLink)
    timeout: float = 30.0
    max_retries: int = 3
    ring_buffer_capacity: int = 2048


class ChannelFrame(BaseModel):
    frame_id: str = Field(default_factory=new_id)
    timestamp: datetime = Field(default_factory=utcnow)
    sample_rate_hz: int = Field(default=20000, ge=1)
    channels: List[int]
    samples_uv: List[List[float]]
    impedance_kohms: Optional[Dict[int, float]] = None
    spectral_blend: Optional[SpectralBlendFrame] = None


class SpikeEvent(BaseModel):
    spike_id: str = Field(default_factory=new_id)
    timestamp_us: int
    electrode_id: int = Field(..., ge=0, le=1023)
    unit_id: int = Field(default=0)
    peak_amplitude_uv: float
