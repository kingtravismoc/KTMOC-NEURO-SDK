neuralink_sdk/dsz/quant.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
DSZ Quantization Module.
"""
from typing import Tuple
import numpy as np


def pack_bits(quantized_array, bits: int) -> bytes:
    if bits == 8:
        return np.asarray(quantized_array, dtype=np.uint8).tobytes()
    packed = []
    val = 0
    shift = 0
    for x in quantized_array:
        val |= (int(x) & ((1 << bits) - 1)) << shift
        shift += bits
        if shift >= 8:
            packed.append(val & 255)
            val = 0
            shift = 0
    if shift > 0:
        packed.append(val & 255)
    return bytes(packed)


def unpack_bits(data: bytes, count: int, bits: int) -> np.ndarray:
    if bits == 8:
        return np.frombuffer(data, dtype=np.uint8)[:count].copy()
    mask = (1 << bits) - 1
    out = np.empty(count, dtype=np.uint8)
    idx = 0
    bit_buf = 0
    bit_len = 0
    for byte in data:
        bit_buf |= byte << bit_len
        bit_len += 8
        while bit_len >= bits and idx < count:
            out[idx] = bit_buf & mask
            bit_buf >>= bits
            bit_len -= bits
            idx += 1
        if idx >= count:
            break
    return out


def pack_nibbles_be(indices: np.ndarray) -> bytes:
    flat = np.asarray(indices, dtype=np.uint8).ravel()
    if len(flat) % 2 != 0:
        flat = np.append(flat, 0)
    hi = (flat[0::2] & 0x0F) << 4
    lo = flat[1::2] & 0x0F
    return (hi | lo).astype(np.uint8).tobytes()


def quantize_codebook(codebook: np.ndarray, cb_min: float = -3.5, cb_max: float = 3.5) -> np.ndarray:
    clipped = np.clip(codebook, cb_min, cb_max)
    scaled = ((clipped - cb_min) / (cb_max - cb_min)) * 255.0
    return np.rint(scaled).astype(np.uint8)


def dequantize_codebook(quantized_cb: np.ndarray, cb_min: float = -3.5, cb_max: float = 3.5) -> np.ndarray:
    return (quantized_cb.astype(np.float32) / 255.0) * (cb_max - cb_min) + cb_min


def build_vq_codebook(
    tensor: np.ndarray,
    block_size: int = 256,
    codebook_size: int = 16,
    iters: int = 12,
    seed: int = 2026,
) -> Tuple[np.ndarray, np.ndarray]:
    flat = np.asarray(tensor, dtype=np.float32).ravel()
    pad_len = (-len(flat)) % block_size
    if pad_len:
        flat = np.pad(flat, (0, pad_len), mode="constant", constant_values=0.0)
    blocks = flat.reshape(-1, block_size)
    n_blocks = blocks.shape[0]

    rng = np.random.default_rng(seed)
    if n_blocks <= codebook_size:
        codebook = np.zeros((codebook_size, block_size), dtype=np.float32)
        codebook[:n_blocks] = blocks
        indices = np.arange(n_blocks, dtype=np.uint8)
        return codebook, indices

    init_idx = rng.choice(n_blocks, size=codebook_size, replace=False)
    codebook = blocks[init_idx].copy()
    indices = np.zeros(n_blocks, dtype=np.uint8)

    for _ in range(iters):
        dists = np.sum((blocks[:, None, :] - codebook[None, :, :]) ** 2, axis=2)
        indices = np.argmin(dists, axis=1).astype(np.uint8)
        for k in range(codebook_size):
            mask = indices == k
            if np.any(mask):
                codebook[k] = blocks[mask].mean(axis=0)
            else:
                codebook[k] = blocks[rng.integers(0, n_blocks)]

    dists = np.sum((blocks[:, None, :] - codebook[None, :, :]) ** 2, axis=2)
    indices = np.argmin(dists, axis=1).astype(np.uint8)
    return codebook, indices

neuralink_sdk/dsz/decompress_engine.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
Standalone High-Performance DSZ Parallel Decompression Engine.
"""
import bz2
from concurrent.futures import ThreadPoolExecutor
from typing import Tuple
import zlib
import numpy as np


def decompress_stream_chunk(chunk_data: bytes, codebook: np.ndarray, block_size: int = 256) -> np.ndarray:
    indices = []
    for byte in chunk_data:
        indices.append(byte >> 4)
        indices.append(byte & 15)
    return np.array([codebook[idx] for idx in indices], dtype=np.float32).flatten()


def decompress_bytes_parallel(
    raw_data: bytes,
    output_shape: Tuple[int, ...],
    block_size: int = 256,
    codebook_size: int = 16,
    max_workers: int = 16,
) -> np.ndarray:
    zlib_decompressor = zlib.decompressobj()
    decompressed_cb = zlib_decompressor.decompress(raw_data)
    unused_data = zlib_decompressor.unused_data
    if not unused_data:
        idx = raw_data.find(b"BZh9")
        if idx != -1:
            unused_data = raw_data[idx:]

    cb_total_bytes = codebook_size * block_size
    quantized_cb = np.frombuffer(decompressed_cb[:cb_total_bytes], dtype=np.uint8).reshape(
        (codebook_size, block_size)
    )
    cb_min, cb_max = -3.5, 3.5
    codebook = (quantized_cb.astype(np.float32) / 255.0) * (cb_max - cb_min) + cb_min

    indices_payload = bz2.decompress(unused_data)
    chunk_size = max(1024, len(indices_payload) // max_workers)
    payload_chunks = [
        indices_payload[i : i + chunk_size] for i in range(0, len(indices_payload), chunk_size)
    ]

    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = [
            executor.submit(decompress_stream_chunk, chunk, codebook, block_size)
            for chunk in payload_chunks
        ]
        results = [f.result() for f in futures]

    return np.concatenate(results)[: int(np.prod(output_shape))].reshape(output_shape)


def decompress_payload_parallel(
    payload_path: str,
    output_shape: Tuple[int, ...],
    block_size: int = 256,
    codebook_size: int = 16,
    max_workers: int = 16,
) -> np.ndarray:
    with open(payload_path, "rb") as f:
        raw_data = f.read()
    return decompress_bytes_parallel(
        raw_data,
        output_shape=output_shape,
        block_size=block_size,
        codebook_size=codebook_size,
        max_workers=max_workers,
    )

neuralink_sdk/dsz/codec.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
DSZ Codec Module.
"""
import bz2
from typing import Dict, Tuple
import zlib
import numpy as np

from .decompress_engine import decompress_bytes_parallel
from .quant import build_vq_codebook, pack_nibbles_be, quantize_codebook


class DSZCodec:
    def __init__(self, block_size: int = 256, codebook_size: int = 16, max_workers: int = 16):
        self.block_size = block_size
        self.codebook_size = codebook_size
        self.max_workers = max_workers

    def encode(self, array: np.ndarray) -> Tuple[bytes, Dict[str, object]]:
        arr = np.asarray(array, dtype=np.float32)
        codebook, indices = build_vq_codebook(
            arr, block_size=self.block_size, codebook_size=self.codebook_size
        )
        q_cb = quantize_codebook(codebook)
        compressed_cb = zlib.compress(q_cb.tobytes(), level=9)
        packed_idx = pack_nibbles_be(indices)
        compressed_idx = bz2.compress(packed_idx, compresslevel=9)
        payload = compressed_cb + compressed_idx

        stats = {
            "output_shape": list(arr.shape),
            "block_size": self.block_size,
            "codebook_size": self.codebook_size,
            "raw_bytes": int(arr.nbytes),
            "compressed_bytes": len(payload),
            "compression_ratio": round(arr.nbytes / max(1, len(payload)), 3),
        }
        return payload, stats

    def decode(self, payload: bytes, output_shape: Tuple[int, ...]) -> np.ndarray:
        return decompress_bytes_parallel(
            payload,
            output_shape=output_shape,
            block_size=self.block_size,
            codebook_size=self.codebook_size,
            max_workers=self.max_workers,
        )

neuralink_sdk/dsz/container.py

"""
KTMOC Neuro SDK | Header: 2026;SFCA
DSZ Container Module.
"""
import hashlib
import json
import struct
from typing import Any, Dict, Optional, Tuple
import numpy as np

from .codec import DSZCodec

DSZ_MAGIC = b"DSZ1"


class DSZContainer:
    def __init__(self, codec: Optional[DSZCodec] = None):
        self.codec = codec or DSZCodec()

    def pack(self, array: np.ndarray, metadata: Optional[Dict[str, Any]] = None) -> bytes:
        payload, stats = self.codec.encode(array)
        digest = hashlib.sha256(payload).hexdigest()
        header = {
            "sdk_header": "KTMOC Neuro SDK",
            "release_tag": "2026;SFCA",
            "sha256": digest,
            **stats,
            "metadata": metadata or {},
        }
        header_bytes = json.dumps(header, sort_keys=True).encode("utf-8")
        return DSZ_MAGIC + struct.pack("<I", len(header_bytes)) + header_bytes + payload

    def inspect_bytes(self, raw_container: bytes) -> Dict[str, Any]:
        if raw_container[:4] != DSZ_MAGIC:
            raise ValueError("Invalid DSZ container magic bytes (expected DSZ1).")
        header_len = struct.unpack("<I", raw_container[4:8])[0]
        header_bytes = raw_container[8 : 8 + header_len]
        return json.loads(header_bytes.decode("utf-8"))

    def unpack(self, raw_container: bytes) -> Tuple[Dict[str, Any], np.ndarray]:
        header = self.inspect_bytes(raw_container)
        header_len = struct.unpack("<I", raw_container[4:8])[0]
        payload = raw_container[8 + header_len :]
        if hashlib.sha256(payload).hexdigest() != header["sha256"]:
            raise ValueError("DSZ container SHA-256 integrity verification failed.")

        codec = DSZCodec(
            block_size=int(header["block_size"]),
            codebook_size=int(header["codebook_size"]),
        )
        arr = codec.decode(payload, tuple(header["output_shape"]))
        return header, arr

    def save(self, path: str, array: np.ndarray, metadata: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        blob = self.pack(array, metadata=metadata)
        with open(path, "wb") as f:
            f.write(blob)
        return self.inspect_bytes(blob)

    def load(self, path: str) -> Tuple[Dict[str, Any], np.ndarray]:
        with open(path, "rb") as f:
            return self.unpack(f.read())

neuralink_sdk/dsz/cli.py, __init__.py, and __main__.py

# neuralink_sdk/dsz/cli.py
"""
KTMOC Neuro SDK | Header: 2026;SFCA
DSZ Command Line Interface.
"""
import argparse
import json
import numpy as np

from .container import DSZContainer
from ..generative import NeuroGenerativeEngine, RuntimeInterrogator
from ..safety.gateway import SafeNeuralinkGateway


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ktmoc-dsz",
        description="KTMOC Neuro SDK (2026;SFCA) DSZ Codec, Generative Engine & Runtime Interrogator CLI",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_comp = sub.add_parser("compress", help="Compress a .npy tensor into a .dsz container")
    p_comp.add_argument("input_npy")
    p_comp.add_argument("output_dsz")

    p_dec = sub.add_parser("decompress", help="Decompress a .dsz container into .npy")
    p_dec.add_argument("input_dsz")
    p_dec.add_argument("output_npy")

    p_insp = sub.add_parser("inspect", help="Inspect a .dsz container manifest")
    p_insp.add_argument("input_dsz")

    p_gen = sub.add_parser("generate", help="Synthesize neural waveforms via embedded generative engine")
    p_gen.add_argument("--channels", type=int, default=8)
    p_gen.add_argument("--samples", type=int, default=256)
    p_gen.add_argument("--out-dsz", default=None)

    sub.add_parser("interrogate", help="Interrogate runtime SDK modules, safety bounds & brain simulant")
    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    container = DSZContainer()

    if args.command == "compress":
        arr = np.load(args.input_npy)
        info = container.save(args.output_dsz, arr)
        print(json.dumps(info, indent=2))
        return 0

    if args.command == "decompress":
        header, arr = container.load(args.input_dsz)
        np.save(args.output_npy, arr)
        print(json.dumps({"restored_shape": list(arr.shape), "header": header}, indent=2))
        return 0

    if args.command == "inspect":
        with open(args.input_dsz, "rb") as f:
            print(json.dumps(container.inspect_bytes(f.read()), indent=2))
        return 0

    if args.command == "generate":
        gw = SafeNeuralinkGateway()
        gen = NeuroGenerativeEngine(gw.brain, gw.blender)
        artifact = gen.generate_neural_batch(channels=args.channels, samples=args.samples)
        if args.out_dsz:
            with open(args.out_dsz, "wb") as f:
                f.write(artifact["dsz_container"])
        summary = {k: v for k, v in artifact.items() if k != "dsz_container"}
        print(json.dumps(summary, indent=2, default=str))
        return 0

    if args.command == "interrogate":
        gw = SafeNeuralinkGateway()
        report = RuntimeInterrogator(gw).interrogate_all()
        print(json.dumps(report, indent=2, default=str))
        return 0

    return 1


if __name__ == "__main__":
    raise SystemExit(main())

