"""
KTMOC Neuro SDK | Header: 2026;SFCA
Core SDK Resource Controllers (Brain Telemetry, DataRepo, BCI Streams, MCP).
"""
import asyncio
from collections import deque
import json
from typing import Any, AsyncIterator, Deque, Dict, List, Optional
import websockets

from .exceptions import StreamConnectionError
from .models import (
    ChannelFrame,
    DatasetRecord,
    DecoderPrediction,
    MCPToolCallRequest,
    MCPToolCallResponse,
    ModalityType,
    SDKConfig,
    SpikeEvent,
    TelemetryEvent,
)
from .transport import AsyncHTTPTransport


class RingBuffer:
    def __init__(self, capacity: int = 2048):
        self.capacity = capacity
        self._queue: Deque[Any] = deque(maxlen=capacity)
        self._lock = asyncio.Lock()

    async def push(self, item: Any) -> None:
        async with self._lock:
            self._queue.append(item)

    async def drain(self) -> List[Any]:
        async with self._lock:
            items = list(self._queue)
            self._queue.clear()
            return items

    def __len__(self) -> int:
        return len(self._queue)


class BrainTelemetryResource:
    def __init__(self, transport: AsyncHTTPTransport):
        self._t = transport

    async def ingest(self, event: TelemetryEvent) -> TelemetryEvent:
        res = await self._t.request(
            "POST",
            "/api/v1/brain/telemetry",
            json_data=event.model_dump(mode="json"),
            correlation_id=event.correlation_id,
        )
        return TelemetryEvent.model_validate(res)

    async def trace_flow(self, correlation_id: str) -> List[TelemetryEvent]:
        res = await self._t.request(
            "GET",
            f"/api/v1/brain/flows/{correlation_id}",
            correlation_id=correlation_id,
        )
        return [TelemetryEvent.model_validate(item) for item in res.get("events", res)]

    async def detect_anomalies(self, threshold: float = 0.75, limit: int = 50) -> List[TelemetryEvent]:
        res = await self._t.request(
            "GET",
            "/api/v1/brain/anomalies",
            params={"threshold": threshold, "limit": limit},
        )
        return [TelemetryEvent.model_validate(item) for item in res.get("anomalies", res)]


class DataRepoResource:
    def __init__(self, transport: AsyncHTTPTransport):
        self._t = transport

    async def list_datasets(
        self,
        modality: Optional[ModalityType] = None,
        subject_code: Optional[str] = None,
        limit: int = 25,
    ) -> List[DatasetRecord]:
        params: Dict[str, Any] = {"limit": limit}
        if modality:
            params["modality"] = modality.value
        if subject_code:
            params["subject_code"] = subject_code

        res = await self._t.request("GET", "/api/v1/datarepo/datasets", params=params)
        items = res.get("datasets", res) if isinstance(res, dict) else res
        return [DatasetRecord.model_validate(d) for d in items]

    async def register_dataset(self, record: DatasetRecord) -> DatasetRecord:
        res = await self._t.request(
            "POST",
            "/api/v1/datarepo/datasets",
            json_data=record.model_dump(mode="json"),
        )
        return DatasetRecord.model_validate(res)

    async def get_dataset(self, dataset_id: str) -> DatasetRecord:
        res = await self._t.request("GET", f"/api/v1/datarepo/datasets/{dataset_id}")
        return DatasetRecord.model_validate(res)


class BCIStreamResource:
    def __init__(self, config: SDKConfig, transport: AsyncHTTPTransport):
        self._config = config
        self._t = transport
        self.frame_buffer = RingBuffer(capacity=config.ring_buffer_capacity)

    async def upload_frame_batch(self, session_id: str, frames: List[ChannelFrame]) -> Dict[str, Any]:
        payload = {
            "session_id": session_id,
            "frames": [f.model_dump(mode="json") for f in frames],
        }
        return await self._t.request("POST", "/api/v1/bci/frames/batch", json_data=payload)

    async def decode_intent(self, session_id: str, spikes: List[SpikeEvent]) -> DecoderPrediction:
        payload = {
            "session_id": session_id,
            "spikes": [s.model_dump(mode="json") for s in spikes],
        }
        res = await self._t.request("POST", "/api/v1/bci/decode", json_data=payload)
        return DecoderPrediction.model_validate(res)

    async def stimulate(
        self,
        regions: List[int],
        drive_amplitude: float,
        frequency_hz: float,
        duration_s: float,
    ) -> Dict[str, Any]:
        payload = {
            "regions": regions,
            "drive_amplitude": drive_amplitude,
            "frequency_hz": frequency_hz,
            "duration_s": duration_s,
        }
        return await self._t.request("POST", "/api/v1/bci/stimulate", json_data=payload)

    async def stream_live(
        self, session_id: str, channels: Optional[List[int]] = None
    ) -> AsyncIterator[ChannelFrame]:
        ws_endpoint = f"{self._config.ws_url.rstrip('/')}/ws/v1/bci/sessions/{session_id}"
        headers = {
            "X-API-Key": self._config.api_key,
            "X-SDK-Header": self._config.sdk_header,
            "X-SDK-Tag": self._config.release_tag,
        }
        if self._config.tenant_id:
            headers["X-Tenant-ID"] = self._config.tenant_id

        try:
            async with websockets.connect(ws_endpoint, additional_headers=headers) as ws:
                if channels:
                    await ws.send(json.dumps({"action": "subscribe", "channels": channels}))

                async for raw_msg in ws:
                    data = json.loads(raw_msg)
                    frame = ChannelFrame.model_validate(data)
                    await self.frame_buffer.push(frame)
                    yield frame
        except Exception as exc:
            raise StreamConnectionError(f"WebSocket stream interrupted: {exc}") from exc


class MCPResource:
    def __init__(self, transport: AsyncHTTPTransport):
        self._t = transport

    async def call_tool(self, request: MCPToolCallRequest) -> MCPToolCallResponse:
        res = await self._t.request(
            "POST",
            "/api/v1/mcp/tools/call",
            json_data=request.model_dump(mode="json"),
            correlation_id=request.correlation_id,
        )
        return MCPToolCallResponse.model_validate(res)

